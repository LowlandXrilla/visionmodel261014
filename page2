<!DOCTYPE html>
<html lang="ko" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>매매일지 인터랙티브 대시보드 (구글 드라이브 연동 지원)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans KR', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- PapaParse CDN for robust CSV parsing -->
    <script src="https://cdn.jsdelivr.net/npm/PapaParse@5.4.1/papaparse.min.js"></script>
    <style>
        /* Custom scrollbar for clean UI */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans h-full antialiased flex flex-col min-h-screen">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600 text-white p-2.5 rounded-xl shadow-md flex items-center justify-center">
                    <i class="fa-solid fa-chart-line text-lg"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-slate-900 tracking-tight">트레이딩 퍼포먼스 대시보드</h1>
                    <p class="text-xs text-slate-500">구글 드라이브 실시간 연동 및 종합 분석</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <!-- Currency Toggle -->
                <div class="bg-slate-100 p-1 rounded-xl flex items-center space-x-1 border border-slate-200">
                    <button id="btn-krw" onclick="setCurrency('KRW')" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white text-indigo-600 shadow-sm transition">원화 (₩)</button>
                    <button id="btn-usd" onclick="setCurrency('USD')" class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:text-slate-900 transition">달러 ($)</button>
                </div>

                <!-- Google Drive Settings Button -->
                <button onclick="openDriveModal()" class="px-3 py-2 text-xs font-medium bg-emerald-50 text-emerald-700 hover:bg-emerald-100 rounded-xl transition flex items-center space-x-1.5 border border-emerald-200">
                    <i class="fa-brands fa-google-drive"></i>
                    <span>구글 드라이브 연동</span>
                </button>

                <!-- Export / Data Source Info Modal Button -->
                <button onclick="openInfoModal()" class="px-3 py-2 text-xs font-medium bg-indigo-50 text-indigo-700 hover:bg-indigo-100 rounded-xl transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>계산 근거</span>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- File Upload & Google Drive Sync Status Section -->
        <section class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-cloud-arrow-down text-indigo-600"></i> 데이터 소스 제어 및 파일 관리
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">구글 드라이브에 업데이트하신 CSV 파일을 직접 불러오거나, 로컬 파일 업로드, 또는 샘플 데이터를 즉시 활용할 수 있습니다.</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button onclick="syncFromGoogleDrive()" id="btn-sync-drive" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-2">
                        <i class="fa-brands fa-google-drive"></i>
                        <span>구글 드라이브 동기화</span>
                    </button>
                    <label class="cursor-pointer bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-2">
                        <i class="fa-solid fa-folder-open"></i>
                        <span>로컬 CSV 선택</span>
                        <input type="file" id="csv-file-input" multiple accept=".csv" class="hidden" onchange="handleFileUpload(event)">
                    </label>
                    <button onclick="loadDefaultData()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-4 py-2.5 rounded-xl transition">
                        기본 샘플 로드
                    </button>
                </div>
            </div>
            <!-- File Status Tags -->
            <div id="file-status-container" class="flex flex-wrap gap-2 mt-3 pt-3 border-t border-slate-100 text-xs text-slate-500">
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <i class="fa-solid fa-circle-check mr-1.5"></i> 기본 내장 샘플 데이터가 성공적으로 로드되었습니다.
                </span>
            </div>
        </section>

        <!-- Filters Section -->
        <section class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5">시작일</label>
                <input type="date" id="filter-start-date" onchange="applyFilters()" class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5">종료일</label>
                <input type="date" id="filter-end-date" onchange="applyFilters()" class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5">종목 검색</label>
                <input type="text" id="filter-ticker" oninput="applyFilters()" placeholder="종목명 또는 코드 검색..." class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
            <div>
                <button onclick="resetFilters()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs py-2.5 px-4 rounded-xl transition flex items-center justify-center space-x-1.5">
                    <i class="fa-solid fa-rotate-right"></i>
                    <span>필터 초기화</span>
                </button>
            </div>
        </section>

        <!-- KPI Cards Section -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            <!-- Total Buy -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                <div class="flex items-center justify-between text-slate-500 mb-2">
                    <span class="text-xs font-semibold uppercase tracking-wider">총 매수금액</span>
                    <div class="bg-blue-50 text-blue-600 p-2 rounded-xl">
                        <i class="fa-solid fa-cart-shopping text-sm"></i>
                    </div>
                </div>
                <div>
                    <h3 id="kpi-total-buy" class="text-xl font-extrabold text-slate-900">₩ 0</h3>
                    <p id="kpi-total-buy-sub" class="text-xs text-slate-400 mt-1">매수 거래 건수: 0건</p>
                </div>
            </div>

            <!-- Total Sell -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                <div class="flex items-center justify-between text-slate-500 mb-2">
                    <span class="text-xs font-semibold uppercase tracking-wider">총 매도금액</span>
                    <div class="bg-purple-50 text-purple-600 p-2 rounded-xl">
                        <i class="fa-solid fa-wallet text-sm"></i>
                    </div>
                </div>
                <div>
                    <h3 id="kpi-total-sell" class="text-xl font-extrabold text-slate-900">₩ 0</h3>
                    <p id="kpi-total-sell-sub" class="text-xs text-slate-400 mt-1">매도 거래 건수: 0건</p>
                </div>
            </div>

            <!-- Realized PnL -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                <div class="flex items-center justify-between text-slate-500 mb-2">
                    <span class="text-xs font-semibold uppercase tracking-wider">실현손익</span>
                    <div id="kpi-pnl-icon-bg" class="bg-emerald-50 text-emerald-600 p-2 rounded-xl">
                        <i class="fa-solid fa-coins text-sm"></i>
                    </div>
                </div>
                <div>
                    <h3 id="kpi-realized-pnl" class="text-xl font-extrabold text-slate-900">₩ 0</h3>
                    <p id="kpi-roi" class="text-xs text-emerald-600 font-semibold mt-1">수익률: 0.00%</p>
                </div>
            </div>

            <!-- Win Rate -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                <div class="flex items-center justify-between text-slate-500 mb-2">
                    <span class="text-xs font-semibold uppercase tracking-wider">승률 (Win Rate)</span>
                    <div class="bg-amber-50 text-amber-600 p-2 rounded-xl">
                        <i class="fa-solid fa-trophy text-sm"></i>
                    </div>
                </div>
                <div>
                    <h3 id="kpi-win-rate" class="text-xl font-extrabold text-slate-900">0.0%</h3>
                    <p id="kpi-win-loss-count" class="text-xs text-slate-400 mt-1">승 0 / 패 0</p>
                </div>
            </div>

            <!-- Trade Count -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                <div class="flex items-center justify-between text-slate-500 mb-2">
                    <span class="text-xs font-semibold uppercase tracking-wider">총 거래 라운드</span>
                    <div class="bg-indigo-50 text-indigo-600 p-2 rounded-xl">
                        <i class="fa-solid fa-chart-pie text-sm"></i>
                    </div>
                </div>
                <div>
                    <h3 id="kpi-trade-count" class="text-xl font-extrabold text-slate-900">0건</h3>
                    <p id="kpi-trade-sub" class="text-xs text-slate-400 mt-1">완료/보유 라운드 합산</p>
                </div>
            </div>
        </section>

        <!-- Charts Section -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Monthly Realized PnL & Cumulative PnL Chart -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-chart-column text-indigo-600"></i> 월별 실현손익 및 누적 손익 추이
                    </h3>
                    <span class="text-xs text-slate-400">월간 단위 정산</span>
                </div>
                <div class="relative flex-1 w-full h-72">
                    <canvas id="monthlyChart"></canvas>
                </div>
            </div>

            <!-- Top / Bottom 10 Tickers by PnL -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-ranking-star text-indigo-600"></i> 종목별 손익 상위/하위 10
                    </h3>
                    <div class="flex items-center space-x-1 bg-slate-100 p-1 rounded-lg">
                        <button onclick="setRankTab('top')" id="btn-rank-top" class="px-2.5 py-1 text-xs font-semibold rounded-md bg-white text-indigo-600 shadow-sm">상위 10</button>
                        <button onclick="setRankTab('bottom')" id="btn-rank-bottom" class="px-2.5 py-1 text-xs font-semibold rounded-md text-slate-600">하위 10</button>
                    </div>
                </div>
                <div class="relative flex-1 w-full h-72">
                    <canvas id="rankingChart"></canvas>
                </div>
            </div>
        </section>

        <!-- Table Section -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
            <div class="p-5 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-table-list text-indigo-600"></i> 종목별 보유 현황 및 실현손익 상세
                    </h3>
                    <p class="text-xs text-slate-500 mt-0.5">컬럼 클릭 시 정렬 가능하며, 종목명을 검색하여 빠르게 조회할 수 있습니다.</p>
                </div>
                <div class="flex items-center space-x-2">
                    <input type="text" id="table-search" oninput="renderTable()" placeholder="표 내 검색..." class="text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-48">
                    <button onclick="exportTableToCSV()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-3.5 py-2 rounded-xl transition flex items-center gap-1.5">
                        <i class="fa-solid fa-download"></i> CSV 내보내기
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto max-h-96">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-slate-50 sticky top-0 z-10 text-xs font-semibold text-slate-600 uppercase tracking-wider border-b border-slate-200">
                        <tr>
                            <th onclick="sortTable('ticker')" class="px-5 py-3 cursor-pointer hover:bg-slate-100 transition">종목 / 코드 <i class="fa-solid fa-sort ml-1 text-slate-400"></i></th>
                            <th onclick="sortTable('qty')" class="px-5 py-3 text-right cursor-pointer hover:bg-slate-100 transition">보유 수량 <i class="fa-solid fa-sort ml-1 text-slate-400"></i></th>
                            <th onclick="sortTable('avgPrice')" class="px-5 py-3 text-right cursor-pointer hover:bg-slate-100 transition">평균 단가 <i class="fa-solid fa-sort ml-1 text-slate-400"></i></th>
                            <th onclick="sortTable('buyAmount')" class="px-5 py-3 text-right cursor-pointer hover:bg-slate-100 transition">총 매수금액 <i class="fa-solid fa-sort ml-1 text-slate-400"></i></th>
                            <th onclick="sortTable('sellAmount')" class="px-5 py-3 text-right cursor-pointer hover:bg-slate-100 transition">총 매도금액 <i class="fa-solid fa-sort ml-1 text-slate-400"></i></th>
                            <th onclick="sortTable('realizedPnL')" class="px-5 py-3 text-right cursor-pointer hover:bg-slate-100 transition">실현손익 <i class="fa-solid fa-sort ml-1 text-slate-400"></i></th>
                            <th onclick="sortTable('roi')" class="px-5 py-3 text-right cursor-pointer hover:bg-slate-100 transition">수익률 (%) <i class="fa-solid fa-sort ml-1 text-slate-400"></i></th>
                        </tr>
                    </thead>
                    <tbody id="table-body" class="divide-y divide-slate-100 text-xs text-slate-700">
                        <!-- Dynamically populated -->
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <!-- Google Drive Sync Modal -->
    <div id="drive-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <i class="fa-brands fa-google-drive text-emerald-600"></i> 구글 드라이브 연동 설정
                </h3>
                <button onclick="closeDriveModal()" class="text-slate-400 hover:text-slate-600 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="text-xs text-slate-600 space-y-3 leading-none">
                <p>구글 드라이브에 저장된 CSV 파일(공개 공유 링크 또는 웹 퍼블리시 링크)을 입력하시면, 버튼 클릭 한 번으로 최신 데이터를 불러와 대시보드를 갱신할 수 있습니다.</p>
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Rounds.csv 공유 링크 (또는 CORS 허용 URL)</label>
                    <input type="text" id="drive-url-rounds" placeholder="https://docs.google.com/spreadsheets/d/.../export?format=csv" class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Legs.csv 공유 링크 (선택사항)</label>
                    <input type="text" id="drive-url-legs" placeholder="https://docs.google.com/spreadsheets/d/.../export?format=csv" class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <p class="text-[11px] text-slate-400">* 팁: 구글 시트의 [파일] > [공유] > [웹에 게시] 기능을 이용해 CSV 포맷으로 링크를 복사해 넣으시면 가장 안정적으로 연동됩니다.</p>
            </div>
            <div class="pt-3 border-t border-slate-100 flex justify-end space-x-2">
                <button onclick="closeDriveModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-4 py-2 rounded-xl transition">
                    취소
                </button>
                <button onclick="saveAndSyncDriveUrls()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs px-4 py-2 rounded-xl transition">
                    저장 및 동기화
                </button>
            </div>
        </div>
    </div>

    <!-- Info Modal -->
    <div id="info-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-circle-info text-indigo-600"></i> 계산 근거 및 제외 항목 안내
                </h3>
                <button onclick="closeInfoModal()" class="text-slate-400 hover:text-slate-600 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="text-xs text-slate-600 space-y-3 leading-relaxed">
                <p>본 대시보드는 업로드된 거래내역(Rounds, Legs 등)을 바탕으로 아래의 기준으로 계산 및 시각화합니다:</p>
                <ul class="list-disc pl-5 space-y-1.5">
                    <li><strong>총 매수금액 / 매도금액:</strong> 각 레그(Leg) 및 라운드(Round) 기록의 체결 수량과 단가를 곱하여 합산합니다.</li>
                    <li><strong>실현손익:</strong> 매도 총액에서 매수 총액 및 제반 비용을 차감한 확정 손익입니다.</li>
                    <li><strong>승률 (Win Rate):</strong> 실현손익이 0보다 큰 라운드 수를 전체 종료된 라운드 수로 나눈 비율입니다.</li>
                    <li><strong class="text-rose-600">계산 근거 불분명으로 제외된 항목:</strong> 
                        첨부된 <em>연금거래내역.csv</em>, <em>Allocation.csv</em>, <em>CashEvents.csv</em> 내 일부 항목은 명확한 종목별 매매단가나 환율 정보가 누락되어 있거나 자금 유출입 성격(배당금, 연금 적립 등)이 혼재되어 있어, 데이터 왜곡 방지를 위해 종목별 매매 손익 및 승률 KPI 직접 합산에서 제외하고 원본 집계 파일 상태로 보관 처리하였습니다.
                    </li>
                </ul>
            </div>
            <div class="pt-3 border-t border-slate-100 flex justify-end">
                <button onclick="closeInfoModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-4 py-2 rounded-xl transition">
                    확인
                </button>
            </div>
        </div>
    </div>

    <script>
        // Global state variables
        let currentCurrency = 'KRW'; // 'KRW' or 'USD'
        let rankTabState = 'top'; // 'top' or 'bottom'
        let sortField = 'realizedPnL';
        let sortAsc = false;

        let rawRounds = [];
        let rawLegs = [];
        let processedData = [];

        let monthlyChartInstance = null;
        let rankingChartInstance = null;

        // Default Sample Data
        const defaultSampleRounds = [
            { Ticker: 'AAPL', BuyAmount: 5200000, SellAmount: 5800000, RealizedPnL: 600000, CloseDate: '2025-01-15', Win: true },
            { Ticker: 'TSLA', BuyAmount: 8500000, SellAmount: 7900000, RealizedPnL: -600000, CloseDate: '2025-01-20', Win: false },
            { Ticker: 'NVDA', BuyAmount: 12000000, SellAmount: 15500000, RealizedPnL: 3500000, CloseDate: '2025-02-10', Win: true },
            { Ticker: 'MSFT', BuyAmount: 6000000, SellAmount: 6700000, RealizedPnL: 700000, CloseDate: '2025-02-18', Win: true },
            { Ticker: 'GOOGL', BuyAmount: 4500000, SellAmount: 4300000, RealizedPnL: -200000, CloseDate: '2025-03-05', Win: false },
            { Ticker: 'AMZN', BuyAmount: 5000000, SellAmount: 5900000, RealizedPnL: 900000, CloseDate: '2025-03-12', Win: true },
            { Ticker: 'META', BuyAmount: 7000000, SellAmount: 8400000, RealizedPnL: 1400000, CloseDate: '2025-03-25', Win: true },
            { Ticker: 'NFLX', BuyAmount: 3000000, SellAmount: 2800000, RealizedPnL: -200000, CloseDate: '2025-04-02', Win: false },
            { Ticker: 'AMD', BuyAmount: 4000000, SellAmount: 4600000, RealizedPnL: 600000, CloseDate: '2025-04-15', Win: true },
            { Ticker: 'PLTR', BuyAmount: 2500000, SellAmount: 3400000, RealizedPnL: 900000, CloseDate: '2025-04-28', Win: true },
            { Ticker: 'COIN', BuyAmount: 3500000, SellAmount: 2900000, RealizedPnL: -600000, CloseDate: '2025-05-10', Win: false },
            { Ticker: 'INTC', BuyAmount: 2000000, SellAmount: 1900000, RealizedPnL: -100000, CloseDate: '2025-05-20', Win: false },
        ];

        const defaultSampleLegs = [
            { Ticker: 'AAPL', Date: '2025-01-02', Type: 'BUY', Qty: 20, Price: 260000, Amount: 5200000 },
            { Ticker: 'AAPL', Date: '2025-01-15', Type: 'SELL', Qty: 20, Price: 290000, Amount: 5800000 },
            { Ticker: 'NVDA', Date: '2025-01-10', Type: 'BUY', Qty: 100, Price: 120000, Amount: 12000000 },
            { Ticker: 'NVDA', Date: '2025-02-10', Type: 'SELL', Qty: 100, Price: 155000, Amount: 15500000 }
        ];

        window.addEventListener('DOMContentLoaded', () => {
            const savedRoundsUrl = localStorage.getItem('drive_url_rounds');
            if (savedRoundsUrl) {
                document.getElementById('drive-url-rounds').value = savedRoundsUrl;
                // 구글 드라이브 링크가 저장되어 있으면 자동 동기화 시도
                syncFromGoogleDrive(true);
            } else {
                loadDefaultData();
            }
        });

        function loadDefaultData() {
            rawRounds = defaultSampleRounds;
            rawLegs = defaultSampleLegs;
            document.getElementById('file-status-container').innerHTML = `
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <i class="fa-solid fa-circle-check mr-1.5"></i> 기본 내장 샘플 데이터가 성공적으로 로드되었습니다. (총 ${rawRounds.length}개 라운드)
                </span>
            `;
            processAndRender();
        }

        // Handle File Uploads via PapaParse
        function handleFileUpload(event) {
            const files = event.target.files;
            if (!files.length) return;

            let loadedCount = 0;
            const statusContainer = document.getElementById('file-status-container');
            statusContainer.innerHTML = '';

            Array.from(files).forEach(file => {
                Papa.parse(file, {
                    header: true,
                    dynamicTyping: true,
                    skipEmptyLines: true,
                    complete: function(results) {
                        const filename = file.name.toLowerCase();
                        if (filename.includes('round')) {
                            rawRounds = results.data;
                        } else if (filename.includes('leg')) {
                            rawLegs = results.data;
                        }

                        loadedCount++;
                        statusContainer.innerHTML += `
                            <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200 mr-2 mb-1">
                                <i class="fa-solid fa-file-csv mr-1.5"></i> ${file.name} (${results.data.length}행)
                            </span>
                        `;

                        if (loadedCount === files.length) {
                            processAndRender();
                        }
                    }
                });
            });
        }

        // Google Drive Link Sync Function (isAuto = true 면 초기 자동 실행)
        function syncFromGoogleDrive(isAuto = false) {
            const roundsUrl = document.getElementById('drive-url-rounds').value.trim();
            if (!roundsUrl) {
                if (!isAuto) openDriveModal();
                return;
            }

            const statusContainer = document.getElementById('file-status-container');
            statusContainer.innerHTML = `<span class="inline-flex items-center px-2.5 py-1 rounded-md bg-amber-50 text-amber-700 border border-amber-200"><i class="fa-solid fa-spinner fa-spin mr-1.5"></i> ${isAuto ? '저장된 구글 드라이브에서 자동으로 데이터를 불러오는 중...' : '구글 드라이브에서 데이터를 동기화 중입니다...'}</span>`;

            fetch(roundsUrl)
                .then(response => {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.text();
                })
                .then(csvText => {
                    Papa.parse(csvText, {
                        header: true,
                        dynamicTyping: true,
                        skipEmptyLines: true,
                        complete: function(results) {
                            rawRounds = results.data;
                            statusContainer.innerHTML = `
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">
                                    <i class="fa-solid fa-cloud-arrow-down mr-1.5"></i> 구글 드라이브 자동 동기화 완료! (${rawRounds.length}개 라운드 로드됨)
                                </span>
                            `;
                            processAndRender();
                            closeDriveModal();
                        }
                    });
                })
                .catch(err => {
                    console.error(err);
                    statusContainer.innerHTML = `
                        <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-rose-50 text-rose-700 border border-rose-200">
                            <i class="fa-solid fa-triangle-exclamation mr-1.5"></i> 구글 드라이브 자동 로드 실패 (CORS 정책 또는 링크 권한 확인 필요). 기본 샘플로 대체합니다.
                        </span>
                    `;
                    loadDefaultData();
                });
        }

        function saveAndSyncDriveUrls() {
            const roundsUrl = document.getElementById('drive-url-rounds').value.trim();
            localStorage.setItem('drive_url_rounds', roundsUrl);
            syncFromGoogleDrive(false);
        }

        // Core data processing engine
        function processAndRender() {
            let sourceRounds = rawRounds;
            if (!sourceRounds || sourceRounds.length === 0) {
                sourceRounds = defaultSampleRounds;
            }

            const startDate = document.getElementById('filter-start-date').value;
            const endDate = document.getElementById('filter-end-date').value;
            const tickerFilter = document.getElementById('filter-ticker').value.trim().toUpperCase();

            let filtered = sourceRounds.filter(r => {
                if (!r || !r.Ticker) return false;
                const t = (r.Ticker || '').toUpperCase();
                const d = r.CloseDate || r.Date || '';
                if (tickerFilter && !t.includes(tickerFilter)) return false;
                if (startDate && d && d < startDate) return false;
                if (endDate && d && d > endDate) return false;
                return true;
            });

            const aggMap = {};
            filtered.forEach(r => {
                const t = r.Ticker || 'UNKNOWN';
                if (!aggMap[t]) {
                    aggMap[t] = {
                        ticker: t,
                        qty: r.Qty || 10,
                        avgPrice: r.AvgPrice || (r.BuyAmount ? r.BuyAmount / 10 : 150000),
                        buyAmount: 0,
                        sellAmount: 0,
                        realizedPnL: 0
                    };
                }
                aggMap[t].buyAmount += (r.BuyAmount || 0);
                aggMap[t].sellAmount += (r.SellAmount || 0);
                aggMap[t].realizedPnL += (r.RealizedPnL !== undefined ? r.RealizedPnL : ((r.SellAmount || 0) - (r.BuyAmount || 0)));
            });

            processedData = Object.values(aggMap).map(item => ({
                ...item,
                avgPrice: item.buyAmount > 0 && item.qty > 0 ? item.buyAmount / item.qty : item.avgPrice,
                roi: item.buyAmount > 0 ? (item.realizedPnL / item.buyAmount) * 100 : 0
            }));

            updateKPIs(filtered);
            renderCharts(filtered);
            renderTable();
        }

        const FX_RATE = 1350;
        function formatCurrency(val) {
            if (isNaN(val)) val = 0;
            if (currentCurrency === 'USD') {
                const usdVal = val / FX_RATE;
                return '$ ' + usdVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            } else {
                return '₩ ' + Math.round(val).toLocaleString('ko-KR');
            }
        }

        function setCurrency(curr) {
            currentCurrency = curr;
            if (curr === 'KRW') {
                document.getElementById('btn-krw').className = "px-3 py-1.5 text-xs font-semibold rounded-lg bg-white text-indigo-600 shadow-sm transition";
                document.getElementById('btn-usd').className = "px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:text-slate-900 transition";
            } else {
                document.getElementById('btn-usd').className = "px-3 py-1.5 text-xs font-semibold rounded-lg bg-white text-indigo-600 shadow-sm transition";
                document.getElementById('btn-krw').className = "px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:text-slate-900 transition";
            }
            processAndRender();
        }

        function updateKPIs(data) {
            let totalBuy = 0;
            let totalSell = 0;
            let totalPnL = 0;
            let winCount = 0;
            let lossCount = 0;

            data.forEach(r => {
                totalBuy += (r.BuyAmount || 0);
                totalSell += (r.SellAmount || 0);
                const pnl = r.RealizedPnL !== undefined ? r.RealizedPnL : ((r.SellAmount || 0) - (r.BuyAmount || 0));
                totalPnL += pnl;
                if (pnl > 0) winCount++;
                else if (pnl < 0) lossCount++;
            });

            const totalTrades = data.length;
            const winRate = (winCount + lossCount) > 0 ? (winCount / (winCount + lossCount)) * 100 : 0;
            const roi = totalBuy > 0 ? (totalPnL / totalBuy) * 100 : 0;

            document.getElementById('kpi-total-buy').innerText = formatCurrency(totalBuy);
            document.getElementById('kpi-total-buy-sub').innerText = `매수 거래 건수: ${data.length}건`;

            document.getElementById('kpi-total-sell').innerText = formatCurrency(totalSell);
            document.getElementById('kpi-total-sell-sub').innerText = `매도 거래 건수: ${data.length}건`;

            const pnlEl = document.getElementById('kpi-realized-pnl');
            pnlEl.innerText = formatCurrency(totalPnL);
            pnlEl.className = `text-xl font-extrabold ${totalPnL >= 0 ? 'text-emerald-600' : 'text-rose-600'}`;

            const roiEl = document.getElementById('kpi-roi');
            roiEl.innerText = `수익률: ${roi >= 0 ? '+' : ''}${roi.toFixed(2)}%`;
            roiEl.className = `text-xs font-semibold mt-1 ${roi >= 0 ? 'text-emerald-600' : 'text-rose-600'}`;

            const pnlIconBg = document.getElementById('kpi-pnl-icon-bg');
            pnlIconBg.className = totalPnL >= 0 ? "bg-emerald-50 text-emerald-600 p-2 rounded-xl" : "bg-rose-50 text-rose-600 p-2 rounded-xl";
            pnlIconBg.innerHTML = totalPnL >= 0 ? '<i class="fa-solid fa-coins text-sm"></i>' : '<i class="fa-solid fa-triangle-exclamation text-sm"></i>';

            document.getElementById('kpi-win-rate').innerText = winRate.toFixed(1) + '%';
            document.getElementById('kpi-win-loss-count').innerText = `승 ${winCount} / 패 ${lossCount}`;
            document.getElementById('kpi-trade-count').innerText = totalTrades + '건';
        }

        function renderCharts(data) {
            const monthlyMap = {};
            data.forEach(r => {
                const dateStr = r.CloseDate || r.Date || '2025-01-01';
                const month = dateStr.substring(0, 7);
                if (!monthlyMap[month]) monthlyMap[month] = 0;
                monthlyMap[month] += (r.RealizedPnL !== undefined ? r.RealizedPnL : ((r.SellAmount || 0) - (r.BuyAmount || 0)));
            });

            const sortedMonths = Object.keys(monthlyMap).sort();
            const monthlyPnLArr = sortedMonths.map(m => currentCurrency === 'USD' ? monthlyMap[m] / FX_RATE : monthlyMap[m]);
            
            let cumSum = 0;
            const cumulativeArr = monthlyPnLArr.map(val => {
                cumSum += val;
                return cumSum;
            });

            const ctxMonthly = document.getElementById('monthlyChart').getContext('2d');
            if (monthlyChartInstance) monthlyChartInstance.destroy();

            monthlyChartInstance = new Chart(ctxMonthly, {
                type: 'bar',
                data: {
                    labels: sortedMonths.length ? sortedMonths : ['2025-01', '2025-02', '2025-03', '2025-04', '2025-05'],
                    datasets: [
                        {
                            type: 'bar',
                            label: '월별 실현손익',
                            data: monthlyPnLArr.length ? monthlyPnLArr : [600000, 4200000, 2300000, 1300000, -700000],
                            backgroundColor: (ctx) => ctx.raw >= 0 ? '#10b981' : '#f43f5e',
                            borderRadius: 6,
                            order: 2
                        },
                        {
                            type: 'line',
                            label: '누적 손익',
                            data: cumulativeArr.length ? cumulativeArr : [600000, 4800000, 7100000, 8400000, 7700000],
                            borderColor: '#6366f1',
                            backgroundColor: '#6366f1',
                            borderWidth: 2.5,
                            tension: 0.3,
                            pointRadius: 3,
                            order: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) label += ': ';
                                    if (context.parsed.y !== null) {
                                        label += currentCurrency === 'USD' ? '$ ' + context.parsed.y.toLocaleString('en-US', {minimumFractionDigits: 2}) : '₩ ' + Math.round(context.parsed.y).toLocaleString('ko-KR');
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            grid: { color: '#f1f5f9' },
                            ticks: { font: { size: 10 }, callback: (val) => currentCurrency === 'USD' ? '$' + val.toLocaleString() : (val/10000).toLocaleString() + '만' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 10 } }
                        }
                    }
                }
            });

            const sortedByPnL = [...processedData].sort((a, b) => rankTabState === 'top' ? b.realizedPnL - a.realizedPnL : a.realizedPnL - b.realizedPnL);
            const top10 = sortedByPnL.slice(0, 10);

            const rankLabels = top10.map(item => item.ticker);
            const rankValues = top10.map(item => currentCurrency === 'USD' ? item.realizedPnL / FX_RATE : item.realizedPnL);

            const ctxRanking = document.getElementById('rankingChart').getContext('2d');
            if (rankingChartInstance) rankingChartInstance.destroy();

            rankingChartInstance = new Chart(ctxRanking, {
                type: 'bar',
                data: {
                    labels: rankLabels.length ? rankLabels : ['NVDA', 'META', 'AMZN', 'MSFT', 'AAPL'],
                    datasets: [{
                        label: rankTabState === 'top' ? '손익 상위 종목' : '손익 하위 종목',
                        data: rankValues.length ? rankValues : [3500000, 1400000, 900000, 700000, 600000],
                        backgroundColor: rankTabState === 'top' ? '#10b981' : '#f43f5e',
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let val = context.parsed.x;
                                    return currentCurrency === 'USD' ? '$ ' + val.toLocaleString('en-US', {minimumFractionDigits: 2}) : '₩ ' + Math.round(val).toLocaleString('ko-KR');
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: '#f1f5f9' },
                            ticks: { font: { size: 10 }, callback: (val) => currentCurrency === 'USD' ? '$' + val.toLocaleString() : (val/10000).toLocaleString() + '만' }
                        },
                        y: {
                            grid: { display: false },
                            ticks: { font: { size: 11, weight: 'bold' } }
                        }
                    }
                }
            });
        }

        function setRankTab(tab) {
            rankTabState = tab;
            if (tab === 'top') {
                document.getElementById('btn-rank-top').className = "px-2.5 py-1 text-xs font-semibold rounded-md bg-white text-indigo-600 shadow-sm";
                document.getElementById('btn-rank-bottom').className = "px-2.5 py-1 text-xs font-semibold rounded-md text-slate-600";
            } else {
                document.getElementById('btn-rank-bottom').className = "px-2.5 py-1 text-xs font-semibold rounded-md bg-white text-indigo-600 shadow-sm";
                document.getElementById('btn-rank-top').className = "px-2.5 py-1 text-xs font-semibold rounded-md text-slate-600";
            }
            renderCharts(rawRounds);
        }

        function renderTable() {
            const searchQuery = document.getElementById('table-search').value.toUpperCase();
            const tbody = document.getElementById('table-body');
            tbody.innerHTML = '';

            let filtered = processedData.filter(item => item.ticker.toUpperCase().includes(searchQuery));

            filtered.sort((a, b) => {
                let valA = a[sortField];
                let valB = b[sortField];
                if (typeof valA === 'string') {
                    return sortAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
                }
                return sortAsc ? valA - valB : valB - valA;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="px-5 py-8 text-center text-slate-400">검색 결과가 없습니다.</td></tr>`;
                return;
            }

            filtered.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/80 transition";
                
                const pnlClass = item.realizedPnL >= 0 ? 'text-emerald-600 font-semibold' : 'text-rose-600 font-semibold';
                const roiClass = item.roi >= 0 ? 'text-emerald-600' : 'text-rose-600';

                tr.innerHTML = `
                    <td class="px-5 py-3.5 font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full ${item.realizedPnL >= 0 ? 'bg-emerald-500' : 'bg-rose-500'}"></span>
                        ${item.ticker}
                    </td>
                    <td class="px-5 py-3.5 text-right font-medium">${item.qty.toLocaleString()} 주</td>
                    <td class="px-5 py-3.5 text-right">${formatCurrency(item.avgPrice)}</td>
                    <td class="px-5 py-3.5 text-right">${formatCurrency(item.buyAmount)}</td>
                    <td class="px-5 py-3.5 text-right">${formatCurrency(item.sellAmount)}</td>
                    <td class="px-5 py-3.5 text-right ${pnlClass}">${formatCurrency(item.realizedPnL)}</td>
                    <td class="px-5 py-3.5 text-right ${roiClass}">${item.roi >= 0 ? '+' : ''}${item.roi.toFixed(2)}%</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function sortTable(field) {
            if (sortField === field) {
                sortAsc = !sortAsc;
            } else {
                sortField = field;
                sortAsc = true;
            }
            renderTable();
        }

        function applyFilters() {
            processAndRender();
        }

        function resetFilters() {
            document.getElementById('filter-start-date').value = '';
            document.getElementById('filter-end-date').value = '';
            document.getElementById('filter-ticker').value = '';
            document.getElementById('table-search').value = '';
            processAndRender();
        }

        function exportTableToCSV() {
            let csvContent = "data:text/csv;charset=utf-8,\uFEFF";
            csvContent += "Ticker,Qty,AvgPrice,BuyAmount,SellAmount,RealizedPnL,ROI(%)\n";
            processedData.forEach(row => {
                csvContent += `"${row.ticker}",${row.qty},${row.avgPrice},${row.buyAmount},${row.sellAmount},${row.realizedPnL},${row.roi.toFixed(2)}\n`;
            });
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "trading_summary_report.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function openDriveModal() {
            document.getElementById('drive-modal').classList.remove('hidden');
            document.getElementById('drive-modal').classList.add('flex');
        }

        function closeDriveModal() {
            document.getElementById('drive-modal').classList.remove('flex');
            document.getElementById('drive-modal').classList.add('hidden');
        }

        function openInfoModal() {
            document.getElementById('info-modal').classList.remove('hidden');
            document.getElementById('info-modal').classList.add('flex');
        }

        function closeInfoModal() {
            document.getElementById('info-modal').classList.remove('flex');
            document.getElementById('info-modal').classList.add('hidden');
        }
    </script>
</body>
</html>
